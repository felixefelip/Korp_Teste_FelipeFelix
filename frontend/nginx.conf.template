server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Sem o fallback, recarregar /inventory/products daria 404: o nginx
  # procuraria um diretorio com esse nome. Toda SPA com rotas precisa disso.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Os assets do build tem hash no nome, entao podem ser cacheados para sempre.
  location ~* \.(js|css|woff2?|png|jpg|svg|ico)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # O destino de cada microservico vem do ambiente, resolvido na subida do
  # container: a mesma imagem serve o compose local (http://inventory:8000) e um
  # deploy onde o frontend mora separado do backend (https://api.exemplo.com).
  #
  # O hostname vai numa variavel do nginx de proposito: com nome literal, ele
  # resolve o DNS na inicializacao e se recusa a subir enquanto a API estiver
  # fora do ar. Com variavel, resolve a cada request.
  location /api/inventory/ {
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $upstream ${INVENTORY_API_UPSTREAM};
    rewrite ^/api/inventory/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_set_header Host $host;
  }

  location /api/billing/ {
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $upstream ${BILLING_API_UPSTREAM};
    rewrite ^/api/billing/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_set_header Host $host;
  }
}
